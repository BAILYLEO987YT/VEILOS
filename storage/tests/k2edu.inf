; K2's driver package: which PCI devices k2edu.sys runs (QEMU's "edu"
; teaching device). VEILOS reads the PCI\VEN_ IDs from it (pnp.rs).
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %VEILOS%
DriverVer   = 11/24/2026,1.0.0.0

[Manufacturer]
%VEILOS% = Veilos,NTamd64

[Veilos.NTamd64]
%EduDesc% = K2Edu_Install, PCI\VEN_1234&DEV_11E8

[K2Edu_Install.NT]
CopyFiles = K2Edu_Files

[K2Edu_Install.NT.Services]
AddService = k2edu, 0x00000002, K2Edu_Service

[K2Edu_Service]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\k2edu.sys

[K2Edu_Files]
k2edu.sys

[Strings]
VEILOS  = "VEILOS"
EduDesc = "QEMU edu device (K2 test driver)"
