#include <windows.h>

101 DIALOGEX 0, 0, 220, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "G3: controls"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Name:", 1000, 7, 8, 30, 8
    EDITTEXT        1001, 40, 6, 100, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Check", 1002, 7, 26, 60, 10
    AUTORADIOBUTTON "One", 1003, 7, 40, 40, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Two", 1004, 50, 40, 40, 10
    LISTBOX         1005, 7, 56, 80, 50, LBS_SORT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    COMBOBOX        1006, 95, 56, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1007, 95, 74, 110, 32, ES_MULTILINE | ES_WANTRETURN | WS_VSCROLL
    SCROLLBAR       1008, 7, 110, 150, 10
    DEFPUSHBUTTON   "OK", IDOK, 110, 135, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 165, 135, 50, 14
END

102 DIALOGEX 0, 0, 120, 50
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Modal"
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT           "Closes itself", -1, 10, 10, 100, 10
    DEFPUSHBUTTON   "OK", IDOK, 35, 28, 50, 14
END
